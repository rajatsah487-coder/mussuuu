<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#2c1b2c">
<title>Ek Mahine Ki Diary — Muskan</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Caveat:wght@500;700&family=Karla:wght@400;500;600&display=swap');

:root{
  --paper:#f4e9d8;
  --paper2:#ece0c9;
  --ink:#3a2318;
  --ink-soft:#6b5140;
  --dusk1:#d9714e;
  --dusk2:#7a3b52;
  --dusk3:#241521;
  --tape:#e3c79c;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Karla,sans-serif;
  overflow-x:hidden;
}
body::before{
  content:"";
  position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:
    radial-gradient(rgba(58,35,24,.05) 1px,transparent 1px);
  background-size:5px 5px;
  opacity:.5;
}
h1,h2,h3{font-family:Fraunces,serif;font-weight:600;margin:0}
.hand{font-family:Caveat,cursive}
section{position:relative;padding:90px 22px;z-index:1}
.wrap{max-width:760px;margin:0 auto}
.wrap-wide{max-width:960px;margin:0 auto}

/* ---------- HERO / DIARY COVER ---------- */
#cover-scene{
  min-height:100svh;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(180deg,var(--dusk3) 0%,#3d2035 45%,var(--dusk2) 78%,var(--dusk1) 100%);
  padding:40px 22px;
}
.diary{
  width:min(380px,86vw);
  aspect-ratio:3/4.1;
  position:relative;
  perspective:1600px;
}
.diary-back{
  position:absolute;inset:0;
  background:var(--paper2);
  border-radius:6px;
  box-shadow:0 30px 70px rgba(0,0,0,.45);
}
.diary-cover{
  position:absolute;inset:0;
  border-radius:6px 10px 10px 6px;
  background:
    linear-gradient(135deg,#8a3f57,#5c2740);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.06), 0 20px 45px rgba(0,0,0,.35);
  transform-origin:left center;
  transform-style:preserve-3d;
  transition:transform 1.1s cubic-bezier(.5,0,.15,1);
  cursor:pointer;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;
  padding:30px;
}
.diary-cover .band{
  position:absolute;left:0;top:0;bottom:0;width:34px;
  background:repeating-linear-gradient(180deg,#3f1c30 0 10px,#4c2339 10px 20px);
}
.diary-cover h1{color:#f7e6ea;font-size:clamp(28px,7vw,38px);line-height:1.15}
.diary-cover .hand{color:#ffd9c2;font-size:clamp(22px,6vw,28px);margin-top:10px}
.diary-cover .tap{margin-top:26px;color:#e9c9d3;font-size:12px;letter-spacing:2px}
.diary.open .diary-cover{transform:rotateY(-155deg)}
.diary-inside{
  position:absolute;inset:0;border-radius:6px;
  background:var(--paper);
  display:flex;align-items:center;justify-content:center;
  padding:36px 26px;text-align:center;
}
.diary-inside p{color:var(--ink-soft);font-size:14px;line-height:1.8;max-width:26ch}
.diary-inside .hand{font-size:26px;color:var(--dusk2);display:block;margin-bottom:10px}

/* ---------- JOURNAL ENTRIES ---------- */
.journal{display:flex;flex-direction:column;gap:56px}
.entry{display:grid;grid-template-columns:64px 1fr;gap:18px;align-items:start}
.entry .datecol{font-family:Caveat;font-size:22px;color:var(--dusk1);line-height:1.2;padding-top:4px;text-align:right;border-right:2px dotted #cbb593;padding-right:14px}
.entry h3{font-size:clamp(22px,4.5vw,28px);margin-bottom:8px;color:var(--ink)}
.entry p{margin:0;color:var(--ink-soft);line-height:1.85;font-size:15.5px}
.section-head{margin-bottom:44px}
.section-head .eyebrow-hand{font-family:Caveat;font-size:22px;color:var(--dusk2)}
.section-head h2{font-size:clamp(30px,7vw,44px);margin-top:4px}

/* ---------- POLAROID GALLERY ---------- */
.polagrid{
  display:flex;flex-wrap:wrap;gap:26px 18px;justify-content:center;
  padding:10px 0 20px;
}
.pola{
  background:#fffaf3;
  padding:12px 12px 34px;
  width:200px;
  box-shadow:0 14px 28px rgba(40,20,20,.22);
  position:relative;
  transition:transform .35s ease, box-shadow .35s ease;
}
.pola:nth-child(6n+1){transform:rotate(-4deg)}
.pola:nth-child(6n+2){transform:rotate(3deg)}
.pola:nth-child(6n+3){transform:rotate(-2deg)}
.pola:nth-child(6n+4){transform:rotate(5deg)}
.pola:nth-child(6n+5){transform:rotate(-5deg)}
.pola:nth-child(6n){transform:rotate(2deg)}
.pola:hover{transform:rotate(0deg) scale(1.04);box-shadow:0 20px 38px rgba(40,20,20,.3);z-index:5}
.pola img{width:100%;height:220px;object-fit:cover;display:block;background:#ddd}
.pola .tape{
  position:absolute;top:-10px;left:50%;transform:translateX(-50%) rotate(-3deg);
  width:70px;height:26px;background:var(--tape);opacity:.85;
  box-shadow:0 2px 4px rgba(0,0,0,.15);
}
.pola .cap{font-family:Caveat;font-size:17px;color:var(--ink-soft);text-align:center;margin-top:10px;line-height:1.2}

/* ---------- SONG / CASSETTE ---------- */
#song{background:var(--dusk3);color:#f6e9ee}
#song .section-head h2{color:#f6e9ee}
#song .section-head .eyebrow-hand{color:#e79bb0}
.cassette-wrap{display:flex;justify-content:center}
.cassette{
  width:min(340px,88vw);
  background:linear-gradient(160deg,#3a2130,#241521);
  border-radius:14px;
  padding:20px;
  box-shadow:0 20px 50px rgba(0,0,0,.4), inset 0 0 0 1px rgba(255,255,255,.05);
}
.cassette .label{
  background:#f4e9d8;border-radius:8px;padding:14px 16px;position:relative;overflow:hidden;
}
.cassette .label .title{font-family:Fraunces;font-size:17px;color:var(--dusk2)}
.cassette .label .sub{font-family:Caveat;font-size:14px;color:var(--ink-soft);margin-top:2px}
.reels{display:flex;justify-content:space-between;margin:18px 30px 6px}
.reel{width:52px;height:52px;border-radius:50%;background:radial-gradient(circle,#161016 0 22%,#4a2c3c 23% 60%,#161016 61% 100%);position:relative}
.reel:before{content:"";position:absolute;inset:0;border-radius:50%;background:
  repeating-conic-gradient(#161016 0 8deg, transparent 8deg 45deg);
  opacity:.6;
}
.cassette.playing .reel{animation:spin 2.4s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
audio{width:100%;margin-top:14px}
.small-note{font-size:12px;color:#cbb7c1;margin-top:12px;text-align:center}

/* ---------- LETTER ---------- */
#letter{background:var(--paper2)}
.paper{
  background:#fffcf6;
  border:1px solid #e6d8bd;
  border-radius:3px;
  padding:34px 30px;
  box-shadow:0 18px 40px rgba(60,35,20,.14);
  position:relative;
}
.paper:before{
  content:"";position:absolute;left:26px;top:0;bottom:0;width:1px;background:#e3b9c2;
}
.paper .clip{
  position:absolute;top:-16px;left:24px;width:34px;height:44px;
  border:5px solid #9aa3ad;border-radius:40% 40% 50% 50%;
  transform:rotate(-8deg);
}
.paper p{
  font-family:Fraunces,serif;font-size:19px;line-height:2;color:var(--ink);
  padding-left:14px;
}
.paper .sign{font-family:Caveat;font-size:28px;color:var(--dusk2);margin-top:6px}

/* ---------- FINAL ---------- */
#final{
  background:linear-gradient(180deg,var(--dusk1) 0%,#7a3b52 55%,var(--dusk3) 100%);
  text-align:center;color:#fdf1e7;
  min-height:70svh;display:flex;align-items:center;
}
#final .big{font-size:clamp(30px,7vw,52px);line-height:1.25}
#final .hand{font-size:clamp(34px,9vw,58px);color:#ffd9c2;display:block;margin-top:18px}
#final .line{width:60px;height:1px;background:#f3c7d3;margin:26px auto}
#final .sub{color:#f0d3dc;font-size:15px}

.reveal{opacity:0;transform:translateY(24px);transition:.9s ease}
.reveal.show{opacity:1;transform:none}

@media(max-width:480px){
  .entry{grid-template-columns:48px 1fr}
  .pola{width:150px}
  .pola img{height:170px}
}
</style>
</head>
<body>

<section id="cover-scene">
  <div class="diary" id="diary">
    <div class="diary-back"></div>
    <div class="diary-cover" id="diaryCover">
      <div class="band"></div>
      <h1>Ek Mahine<br>Ki Diary</h1>
      <div class="hand">13 Aug — 13 Sep 2026</div>
      <div class="tap">TAP TO OPEN</div>
    </div>
    <div class="diary-inside">
      <div>
        <span class="hand">for Muskan</span>
        <p>Scroll kar aur padh, dekh, sun — jo bhi is mahine mein humara hua.</p>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap reveal">
    <div class="section-head">
      <div class="eyebrow-hand">page one</div>
      <h2>Jab se tum aayi.</h2>
    </div>
    <div class="journal">
      <div class="entry">
        <div class="datecol">13<br>Aug</div>
        <div>
          <h3>Shuruaat</h3>
          <p>Ordinary days achanak special lagne lage. Ek "hum" bann gaya jo pehle sirf soch thi.</p>
        </div>
      </div>
      <div class="entry">
        <div class="datecol">beech<br>mein</div>
        <div>
          <h3>Chhoti baatein, badi feelings</h3>
          <p>Silly jhagde, lambi calls, random jokes, aur woh care jo bina bole samajh aata hai — yeh sab hi toh "us" hai.</p>
        </div>
      </div>
      <div class="entry">
        <div class="datecol">13<br>Sep</div>
        <div>
          <h3>Aaj</h3>
          <p>Ek mahina poora hua. Aur main abhi bhi tumhe dekh ke sochta hoon — itna lucky kaise ho gaya main.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap-wide reveal">
    <div class="section-head" style="text-align:center">
      <div class="eyebrow-hand">page two</div>
      <h2>Jo photos hum nahi bhoolenge.</h2>
    </div>
    <div class="polagrid">
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">us sunset ne haar maan li</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">quiet moment, swing pe</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">meri favourite frame</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">mall waala din</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">tumhari smile, close-up</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">candid ke liye best</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">garden waali baatein</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">hug jo kabhi khatam na ho</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">bench pe hasi mazak</div></div>
      <div class="pola"><div class="tape"></div><img src="data:image/jpeg;base64," alt=""><div class="cap">aur bohot saari aane wali</div></div>
    </div>
  </div>
</section>

<section id="song">
  <div class="wrap reveal" style="text-align:center">
    <div class="section-head">
      <div class="eyebrow-hand">page three</div>
      <h2>Humara gaana.</h2>
    </div>
    <div class="cassette-wrap">
      <div class="cassette" id="cassette">
        <div class="label">
          <div class="title">Apna Bana Le</div>
          <div class="sub">for Muskan, on repeat</div>
        </div>
        <div class="reels"><div class="reel"></div><div class="reel"></div></div>
        <audio id="audio" controls preload="metadata">
          <source src="data:audio/mpeg;base64," type="audio/mpeg">
        </audio>
      </div>
    </div>
    <div class="small-note">Play dabao — pehli tap ke baad hi baraber baj sakta hai kuch browsers mein.</div>
  </div>
</section>

<section id="letter">
  <div class="wrap reveal">
    <div class="section-head">
      <div class="eyebrow-hand">page four</div>
      <h2>Dear Muskan…</h2>
    </div>
    <div class="paper">
      <div class="clip"></div>
      <p>
        Sach bolu toh mujhe kabhi kabhi samajh nahi aata ki tumhare liye exactly kya likhun, kyunki jo feel karta hoon woh words se thoda bada lagta hai.
        <br><br>
        Tum meri life mein aayi aur pata hi nahi chala kab ordinary days special lagne lage. Tumhari smile, tumhari voice, tumhari care, tumhari chhoti-chhoti baatein — sab kuch mere liye matter karta hai.
        <br><br>
        Mujhe perfect story nahi chahiye. Mujhe bas humari real story chahiye — jisme hasi ho, thodi nok-jhok ho, kabhi stupid moments ho, kabhi serious talks ho, aur har baar ek doosre ko choose karne ki wajah ho.
        <br><br>
        Happy one month, meri Ladduuu.
      </p>
      <div class="sign">— tumhara</div>
    </div>
  </div>
</section>

<section id="final">
  <div class="wrap reveal">
    <div class="date hand" style="letter-spacing:2px">13.08.2026 → 13.09.2026</div>
    <div class="big">Ek mahina poora hua…<br>aur yeh toh bas shuruaat hai.</div>
    <span class="hand">Forever baaki hai. ♾️</span>
    <div class="line"></div>
    <p class="sub">I love you, Muskan.</p>
  </div>
</section>

<script>
document.getElementById('diaryCover').addEventListener('click',()=>{
  document.getElementById('diary').classList.add('open');
});

const audio=document.getElementById('audio'), cassette=document.getElementById('cassette');
audio.addEventListener('play',()=>cassette.classList.add('playing'));
audio.addEventListener('pause',()=>cassette.classList.remove('playing'));

const observer=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('show')});
},{threshold:.12});
document.querySelectorAll('.reveal').forEach(x=>observer.observe(x));
</script>
</body>
</html>
